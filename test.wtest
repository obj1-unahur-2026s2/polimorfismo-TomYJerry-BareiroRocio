import tomYJerry.*

test " La velocidad maximima inicial de tom es 10 "{
    assert.equals(10, tom.velocidadMaxima())
}

test " Tom come a jerry y su velocidad maxima pasa a ser 15.2"{
    tom.comer(jerry)
    assert.equals(15.2,tom.velocidadMaxima())
}

test "tom corre 24 metros y su velocidad maxima pasa a ser 14 y su energia es 90"{
    tom.comer(jerry)
    tom.correr(24)
    assert.equals(14,tom.velocidadMaxima())
    assert.equals(90,tom.energia())
   
}

test "tom come a nibbles y su velocidad maxima es 18.7 y su eneria es 137"{
    tom.comer(jerry)
    tom.correr(24)
    tom.comer(nibbles)
    assert.equals(18.7,tom.velocidadMaxima())
    assert.equals(137,tom.energia())
}

test  "Jerry cumple años y Tom lo vuelve a comer"{
     tom.comer(jerry)
    tom.correr(24)
    tom.comer(nibbles)
    jerry.cumplirAños()
    tom.comer(jerry)
    assert.equals(25.9,tom.velocidadMaxima())
    assert.equals(209,tom.energia())

}

test "tom corre 38 metros"{
      tom.comer(jerry)
    tom.correr(24)
    tom.comer(nibbles)
    jerry.cumplirAños()
    tom.comer(jerry)
    tom.correr(38)
    assert.equals(24,tom.velocidadMaxima())
    assert.equals(190,tom.energia())
}
